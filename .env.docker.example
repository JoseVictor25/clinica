# Copia este archivo como .env.docker. No subas el archivo real.
COMPOSE_PROJECT_NAME=clinica

# Puertos publicados en desarrollo
POSTGRES_PORT_EXTERNAL=5433
BACKEND_PORT_EXTERNAL=8000
FRONTEND_PORT_EXTERNAL=5173
HTTP_PORT_EXTERNAL=8080

# Django
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,10.0.2.2
TIME_ZONE=America/La_Paz
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
TRUST_PROXY_HEADERS=False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# PostgreSQL. Dentro de Docker el host siempre es db y el puerto 5432.
DB_NAME=clinicas_db
DB_USER=clinicas
DB_PASSWORD=cambia-esta-contrasena
DB_HOST=db
DB_PORT=5432

# JWT y throttling
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
LOGIN_THROTTLE_RATE=5/min

# Datos semilla opcionales
ADMIN_SISTEMA_USERNAME=admin_sistema
ADMIN_SISTEMA_EMAIL=admin@clinicas.local
ADMIN_SISTEMA_PASSWORD=cambia-esta-contrasena
SEED_CREAR_CLINICA_DEMO=True
SEED_CLINICA_DEMO_NIT=DEMO-0001
SEED_CLINICA_DEMO_NOMBRE=Clinica Demo
