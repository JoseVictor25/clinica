{
	admin off
}

{$SITE_ADDRESS} {
	encode zstd gzip

	@django path /api/* /admin/* /static/*
	handle @django {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:80
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
