# Copia este archivo a .env y completa tus valores reales.
# NO subas .env al repositorio. Todos los secretos viven únicamente en .env.

# --- Django ---
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/La_Paz

# --- PostgreSQL ---
DB_NAME=clinicas_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- CORS (frontend React/Vite) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- JWT y throttling ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
LOGIN_THROTTLE_RATE=5/min

# --- Administrador del sistema inicial (semilla) ---
ADMIN_SISTEMA_USERNAME=admin_sistema
ADMIN_SISTEMA_EMAIL=admin@clinicas.local
ADMIN_SISTEMA_PASSWORD=

# --- Datos demo de la semilla ---
# Si es True y no existe ninguna clínica, la semilla crea una clínica demo
# para poder cargar roles y especialidades base.
SEED_CREAR_CLINICA_DEMO=True
SEED_CLINICA_DEMO_NIT=DEMO-0001
SEED_CLINICA_DEMO_NOMBRE=Clinica Demo
