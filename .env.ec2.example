# Copia este archivo como .env.ec2 en la instancia. No subas el archivo real.
COMPOSE_PROJECT_NAME=clinica

# Usa tu dominio para activar HTTPS automatico, por ejemplo: clinica.ejemplo.com
# Mientras pruebas solo con la IP publica y HTTP, usa :80
SITE_ADDRESS=:80

# Django. Genera SECRET_KEY con el comando indicado en docs/aws-ec2.md.
SECRET_KEY=reemplaza-con-una-clave-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=IP_PUBLICA_O_DOMINIO
TIME_ZONE=America/La_Paz

# Para IP/HTTP: http://IP_PUBLICA. Para dominio/HTTPS: https://clinica.ejemplo.com
CSRF_TRUSTED_ORIGINS=http://IP_PUBLICA
CORS_ALLOWED_ORIGINS=http://IP_PUBLICA
TRUST_PROXY_HEADERS=True

# Mantener en False mientras se use HTTP por IP. Cambiar las tres a True con HTTPS.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# PostgreSQL solo es accesible dentro de Docker.
DB_NAME=clinicas_db
DB_USER=clinicas
DB_PASSWORD=reemplaza-con-una-contrasena-larga-y-aleatoria
DB_HOST=db
DB_PORT=5432

# JWT y proteccion del inicio de sesion.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
LOGIN_THROTTLE_RATE=5/min

# Datos iniciales. Cambia la contrasena antes de ejecutar la semilla.
ADMIN_SISTEMA_USERNAME=admin_sistema
ADMIN_SISTEMA_EMAIL=admin@tu-dominio.com
ADMIN_SISTEMA_PASSWORD=reemplaza-con-otra-contrasena-larga
SEED_CREAR_CLINICA_DEMO=False
SEED_CLINICA_DEMO_NIT=DEMO-0001
SEED_CLINICA_DEMO_NOMBRE=Clinica Demo
